# Copy to .env at repository root; never commit real secrets.
PORT=3000
# Use an absolute path in production. Do not change an existing DATA_DIR on update.
# DATA_DIR=/www/wwwroot/sw/server/data
AUTO_FIRST_ADMIN=1
# Optional recovery/explicit administrators (existing usernames, comma separated).
ADMIN_USERNAMES=
# Behind HTTPS reverse proxy set 1; local HTTP testing set 0.
SECURE_COOKIE=1
# 0 for a fresh installation without demo posts; does not delete existing content.
SEED_DEMO=0
# Optional GitHub OAuth application credentials:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Optional New API / OpenAI-compatible gateway. Prefer HTTPS in production.
# Alternatively configure URL/model/key in the authenticated admin AI panel.
AI_ENABLED=0
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional stable encryption secret. If empty, DATA_DIR/.ai-config-key is generated
# (0600). Keep this key with database backups. Never change it on update.
AI_CONFIG_SECRET=
# Only for trusted local/private New API deployments; never enable for untrusted HTTP.
AI_ALLOW_HTTP=0
# Site-wide rolling-24h chat job cap (includes failed/refused jobs). Per-user: 50/day.
AI_DAILY_CHAT_LIMIT=500

# Optional real email delivery. Local username/password accounts do not require SMTP.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Test-only plaintext SMTP; leave 0 in production. STARTTLS is required on port 587.
SMTP_ALLOW_INSECURE=0
