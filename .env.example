# Copy to .env at repository root; never commit real secrets.
PORT=3000
# Use an absolute path in production. Do not change an existing DATA_DIR on update.
# DATA_DIR=/www/wwwroot/sw/server/data
AUTO_FIRST_ADMIN=1
# Optional recovery/explicit administrators (existing usernames, comma separated).
ADMIN_USERNAMES=
# Behind HTTPS reverse proxy set 1; local HTTP testing set 0.
SECURE_COOKIE=1
# 0 for a fresh installation without demo posts; does not delete existing content.
SEED_DEMO=0
# Optional GitHub OAuth application credentials:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
